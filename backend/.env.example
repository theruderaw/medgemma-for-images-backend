PORT=3000

# Postgres (backend DB, used by Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/document_pipeline?schema=public"

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Local file storage root (swap for S3/GCS in storage.service.ts)
STORAGE_DIR=./uploads

# Inference server (MedGemma / analysis / embeddings / RAG service)
INFERENCE_BASE_URL=http://localhost:8000

MAX_UPLOAD_MB=20
JSON_BODY_LIMIT_MB=50